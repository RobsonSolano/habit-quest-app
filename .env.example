# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mixpanel
MIXPANEL_TOKEN=

# Sentry (DSN em: Sentry Project > Settings > Client Keys)
EXPO_PUBLIC_SENTRY_DSN=
# Opcional: enviar eventos em dev para testar (default: false)
EXPO_PUBLIC_SENTRY_ENABLED_IN_DEV=false
# Para upload de source maps no build: SENTRY_AUTH_TOKEN (não commitar)

#Google cloud
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_SECRET_WEB=

EXPO_PUBLIC_ADMOB_APP_ID=seu-app-id-aqui
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=seu-interstitial-id-aqui